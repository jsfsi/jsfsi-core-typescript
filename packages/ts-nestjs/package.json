{
  "name": "@jsfsi-core/ts-nestjs",
  "version": "2.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsfsi/jsfsi-core-typescript.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run lint && tsc --noEmit && vite build && node ../../scripts/check-dist-names.mjs AllExceptionsFilter RequestMiddleware",
    "build:watch": "tsc && (tsc --watch & vite build --watch)",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf coverage",
    "format": "biome format --write src",
    "lint": "biome check --write src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jsfsi-core/ts-crossplatform": "file:../ts-crossplatform",
    "@jsfsi-core/ts-nodejs": "file:../ts-nodejs",
    "@nestjs/cli": "12.0.11",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "body-parser": "2.4.0",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  },
  "peerDependenciesMeta": {
    "body-parser": {
      "optional": false
    },
    "express": {
      "optional": false
    }
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  }
}
